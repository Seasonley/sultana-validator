{
  "name": "sultana-validator",
  "version": "1.0.2",
  "description": "A library for validating as same as validator.py",
  "license": "MIT",
  "author": "seasonley",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "validator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seasonley/sultana-validator.git"
  },
  "bugs": {
    "url": "https://github.com/Seasonley/sultana-validator/issues"
  },
  "homepage": "https://github.com/Seasonley/sultana-validator"
}